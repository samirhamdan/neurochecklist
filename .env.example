# ============================================================
# RASTREAMENTO — copie este arquivo para .env.local e preencha.
# Sem os IDs, os scripts de rastreamento simplesmente não são
# carregados (a página funciona normalmente).
# Na Vercel: Settings > Environment Variables.
# ============================================================

# [PREENCHER] Meta Pixel ID (Gerenciador de Eventos do Meta Business)
NEXT_PUBLIC_META_PIXEL_ID=

# [PREENCHER] Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# [PREENCHER] URL pública final do site (usada em canonical/Open Graph)
# Ex.: https://neurochecklist.com.br
NEXT_PUBLIC_SITE_URL=
